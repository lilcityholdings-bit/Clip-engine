# Claude API key used to pick clip moments and write titles
ANTHROPIC_API_KEY=
# YouTube OAuth (run scripts/get_youtube_token.py once to get the refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional: YouTube Data API key for reading trending charts (falls back to OAuth)
YOUTUBE_API_KEY=
# Where the SQLite database and temporary video files live (mount a Railway volume here)
DATA_DIR=/data
# YouTube allows ~6 uploads/day on the default 10,000-unit API quota
MAX_UPLOADS_PER_DAY=5
# public | unlisted | private
PRIVACY_STATUS=public
TREND_REGION=US
# Hours to wait before scoring a video's performance
SCORE_AFTER_HOURS=48
# Whisper model size for transcription: tiny, base, small
WHISPER_MODEL=base
# Clipping campaigns you've joined (JSON list, see clip_engine/campaigns.py). Empty = public-domain archive mode.
CAMPAIGNS_JSON=
# Discord or Slack webhook that receives the day's links to submit
DIGEST_WEBHOOK_URL=
# Only this many minutes from the start of each source video are searched for clips
MAX_TRANSCRIBE_MINUTES=60
