# --- Required ---------------------------------------------------------------
# Claude API key: picks clip moments and writes titles
ANTHROPIC_API_KEY=
# Where the database, rendered clips and temp files live (mount a Railway volume here)
DATA_DIR=/data
# Password for the dashboard (any username)
DASHBOARD_PASSWORD=
# This service's public address, e.g. https://clip-engine.up.railway.app (Instagram fetches clips from it)
PUBLIC_BASE_URL=

# --- YouTube (run scripts/get_youtube_token.py once) -------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
PRIVACY_STATUS=public
# ~6 uploads/day fit the default API quota
MAX_UPLOADS_PER_DAY=5

# --- TikTok (Content Posting API; scopes video.publish and video.list) -------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY until TikTok audits the app, then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
TIKTOK_MAX_PER_DAY=15

# --- Instagram (API with Instagram Login; professional account) --------------
INSTAGRAM_USER_ID=
# Long-lived token; refreshed automatically every week
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MAX_PER_DAY=25

# --- Clipping campaigns ------------------------------------------------------
# JSON list of campaigns you've joined (format in clip_engine/campaigns.py). Empty = public-domain archive mode.
CAMPAIGNS_JSON=
# Discord or Slack webhook: links to submit, plus failure alerts
DIGEST_WEBHOOK_URL=
# Contents of a cookies.txt from a signed-in browser, if YouTube blocks downloads from the server
YTDLP_COOKIES=

# --- Tuning ------------------------------------------------------------------
MAX_CLIPS_PER_DAY=6
SCORE_AFTER_HOURS=48
TREND_REGION=US
# Whisper model: tiny, base, small (bigger = better transcripts, slower)
WHISPER_MODEL=base
# Only this many minutes from the start of each source video are searched for clips
MAX_TRANSCRIBE_MINUTES=60
